/**
 * secrets.h — WiFi and MQTT credentials for the ESP32 firmware.
 *
 * ⚠  IMPORTANT: This file is listed in .gitignore — NEVER commit real credentials!
 *
 * To use:
 *   1. Copy this file:  cp secrets.h.example secrets.h
 *   2. Fill in your WiFi SSID, password, and Raspberry Pi IP below.
 */
#pragma once

// ── WiFi Credentials ──────────────────────────────────────────────────────────
#define WIFI_SSID       "YOUR_WIFI_SSID_HERE"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD_HERE"

// ── Raspberry Pi MQTT Broker ──────────────────────────────────────────────────
#define MQTT_BROKER_IP  "192.168.1.250"   // IP of your Raspberry Pi
#define MQTT_PORT       1883
#define MQTT_USER       ""                // Leave blank if broker has no auth
#define MQTT_PASS       ""
